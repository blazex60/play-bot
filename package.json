{
  "name": "music-bot",
  "version": "1.0.0",
  "description": "Discord music bot using discord.js v14 + @discordjs/voice",
  "type": "module",
  "main": "src/index.js",
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "bun": ">=1.2.0"
  },
  "scripts": {
    "start": "node src/deploy.js --if-changed && node src/index.js",
    "deploy": "node src/deploy.js",
    "test": "bun run test:server",
    "test:server": "bun scripts/run-node-tests.mjs --suite server",
    "test:web": "bun test --preload ./web/happy-dom-register.js --preload ./web/bun-test-setup.js web/src",
    "test:browser": "bun scripts/run-browser-tests.mjs",
    "test:e2e": "bun run test:browser",
    "test:container": "bun scripts/run-node-tests.mjs --suite container",
    "typecheck": "tsc --noEmit -p web/tsconfig.json && bun -e \"console.log('P0_TYPECHECK_OK')\"",
    "build:web": "bun scripts/build-web.mjs",
    "db:inspect": "node src/db/inspect.js",
    "plan:validate": "node test/plan/validate-plan.mjs",
    "qa:task": "bun scripts/qa-task.mjs",
    "check": "bun run test:server && bun run test:web && bun run typecheck && bun run build:web && bun run test:e2e"
  },
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.2",
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^8.3.0",
    "better-sqlite3": "^12.4.1",
    "discord.js": "^14.16.0",
    "dotenv": "^16.4.0",
    "essentia.js": "^0.1.3",
    "fastify": "^5.6.2",
    "libsodium-wrappers": "^0.7.15",
    "opusscript": "^0.0.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.2",
    "@playwright/test": "^1.56.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "happy-dom": "^20.0.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.1"
  },
  "trustedDependencies": [
    "@discordjs/opus",
    "better-sqlite3",
    "esbuild"
  ]
}
